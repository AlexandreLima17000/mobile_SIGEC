<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="18dp"
        android:paddingBottom="24dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <!-- MOLDURA -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- FAIXA LATERAL -->
                <View
                    android:layout_width="6dp"
                    android:layout_height="match_parent"
                    android:background="@color/secondary_container" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">


                    <!-- ============================ -->
                    <!-- CABEÇALHO -->
                    <!-- ============================ -->

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/primary">

                        <ImageView
                            android:layout_width="45dp"
                            android:layout_height="45dp"
                            android:layout_gravity="top|end"
                            android:src="@drawable/bg_card_corner_accent"
                            app:tint="#40000000" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="RECEITA"
                                android:textColor="@color/secondary_container"
                                android:textSize="12sp"
                                android:textStyle="bold" />


                            <!-- NOME VINDO DO BANCO -->

                            <TextView
                                android:id="@+id/txtNomeReceita"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Nome da Receita"
                                android:textColor="@color/secondary_container"
                                android:textSize="26sp"
                                android:textStyle="bold"
                                android:layout_marginTop="4dp" />

                        </LinearLayout>

                    </FrameLayout>


                    <!-- ============================ -->
                    <!-- CORPO -->
                    <!-- ============================ -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">


                        <!-- TÍTULO -->

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Modo de Preparo"
                            android:textColor="@color/secondary_container"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="12dp" />


                        <!-- PREPARO VINDO DO BANCO -->

                        <TextView
                            android:id="@+id/txtPreparoReceita"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Modo de preparo da receita..."
                            android:textColor="#333333"
                            android:textSize="16sp"
                            android:background="#E2E8F0"
                            android:padding="14dp"
                            android:lineSpacingExtra="4dp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>