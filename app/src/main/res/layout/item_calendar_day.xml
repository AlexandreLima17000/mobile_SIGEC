<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/day_container"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:background="@drawable/bg_calendar_day_weekday"
    android:clickable="true"
    android:focusable="true">

    <!-- Número do dia no canto superior esquerdo -->
    <TextView
        android:id="@+id/day_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="4dp"
        android:layout_marginTop="2dp"
        android:textColor="@color/sigec_dark_blue"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Ponto escuro/preto de fim de semana ou indicador no canto inferior esquerdo/centro -->
    <ImageView
        android:id="@+id/dot_weekend"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="6dp"
        android:layout_marginBottom="6dp"
        android:contentDescription="Fim de semana"
        android:src="@drawable/ic_dot"
        android:visibility="gone" />

    <!-- Indicadores de aulas alocadas (bolinhas na parte inferior) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="6dp"
        android:layout_marginBottom="6dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/dot1"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginEnd="3dp"
            android:contentDescription="Indicador 1"
            android:src="@drawable/ic_dot"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/dot2"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:contentDescription="Indicador 2"
            android:src="@drawable/ic_dot"
            android:visibility="gone" />
    </LinearLayout>

</FrameLayout>
