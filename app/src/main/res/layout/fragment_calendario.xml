<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    tools:context=".calendario.CalendarioFragment">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Marca d'água "SIGEC" translúcida no fundo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="16dp"
            android:letterSpacing="0.05"
            android:text="SIGEC"
            android:textColor="#10002F6C"
            android:textSize="110sp"
            android:textStyle="bold" />

        <!-- Card Container Principal do Calendário -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/sigec_calendar_container_bg"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Faixa Laranja Lateral de Destaque -->
                <View
                    android:layout_width="8dp"
                    android:layout_height="match_parent"
                    android:background="@color/sigec_orange" />

                <!-- Conteúdo Interno Principal -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- Header Superior: Ícone + Título + Subtítulo -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:contentDescription="Ícone Calendário"
                            android:src="@drawable/ic_calendar_white" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Planejamento de Aulas"
                                android:textColor="@color/white"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Chef Fulano - Instrutor Gastronomia"
                                android:textColor="#D1D9E0"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Barra de Busca -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_search_bar"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="8dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="Buscar"
                            android:src="@drawable/ic_search"
                            app:tint="#D1D9E0" />

                        <EditText
                            android:id="@+id/edit_search_aula"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@null"
                            android:hint="Buscar receita, turma..."
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:textColor="@color/white"
                            android:textColorHint="#9EABB6"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Barra de Mês e Controles de Navegação -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:id="@+id/btn_menu_list"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:contentDescription="Menu"
                            android:src="@drawable/ic_menu"
                            app:tint="@color/white" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/btn_prev_month"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:clickable="true"
                                android:contentDescription="Mês Anterior"
                                android:focusable="true"
                                android:padding="2dp"
                                android:src="@drawable/ic_chevron_left_white" />

                            <TextView
                                android:id="@+id/text_month_year"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="12dp"
                                android:text="SETEMBRO 2026."
                                android:textColor="@color/white"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:id="@+id/btn_next_month"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:clickable="true"
                                android:contentDescription="Próximo Mês"
                                android:focusable="true"
                                android:padding="2dp"
                                android:src="@drawable/ic_chevron_right_white" />
                        </LinearLayout>
                    </RelativeLayout>

                    <!-- Cabeçalho dos Dias da Semana -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/sigec_weekday_bg"
                        android:orientation="horizontal"
                        android:paddingVertical="4dp">

                        <TextView
                            style="@style/CalendarDayHeader"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="DOM"
                            android:textColor="@color/sigec_dark_blue" />

                        <TextView
                            style="@style/CalendarDayHeader"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="SEG"
                            android:textColor="@color/sigec_dark_blue" />

                        <TextView
                            style="@style/CalendarDayHeader"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="TER"
                            android:textColor="@color/sigec_dark_blue" />

                        <TextView
                            style="@style/CalendarDayHeader"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="QUA"
                            android:textColor="@color/sigec_dark_blue" />

                        <TextView
                            style="@style/CalendarDayHeader"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="QUI"
                            android:textColor="@color/sigec_dark_blue" />

                        <TextView
                            style="@style/CalendarDayHeader"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="SEX"
                            android:textColor="@color/sigec_dark_blue" />

                        <TextView
                            style="@style/CalendarDayHeader"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="SÁB"
                            android:textColor="@color/sigec_dark_blue" />
                    </LinearLayout>

                    <!-- Grid dos Dias do Mês -->
                    <GridLayout
                        android:id="@+id/calendar_grid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="7" />

                    <!-- Barra de Legendas -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/sigec_legend_bg"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="6dp">

                        <ImageView
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:contentDescription="Ponto Laranja"
                            android:src="@drawable/ic_dot"
                            app:tint="@color/sigec_orange" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="Com aula agendada"
                            android:textColor="@color/sigec_orange"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_marginStart="10dp"
                            android:contentDescription="Ponto Vermelho"
                            android:src="@drawable/ic_dot"
                            app:tint="@color/sigec_red" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="Com aula agendada"
                            android:textColor="@color/sigec_red"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_marginStart="10dp"
                            android:contentDescription="Ponto Preto"
                            android:src="@drawable/ic_dot"
                            app:tint="@color/black" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="Fim de semana"
                            android:textColor="@color/black"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Painel de Agenda / Fichas Alocadas -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/white"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/text_current_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="21 de setembro de 2026"
                            android:textColor="@color/sigec_orange"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="FICHAS ALOCADAS (AGENDA DO DIA)"
                            android:textColor="#42474F"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/layout_fichas_lista"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/text_no_fichas"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Nenhuma aula ou ficha programada para este dia."
                                android:textColor="#757575"
                                android:textSize="13sp" />
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </FrameLayout>

</ScrollView>
