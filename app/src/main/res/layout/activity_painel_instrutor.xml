<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <!-- Marca d'água "SIGEC" translúcida no fundo -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SIGEC"
        android:textColor="#10002747"
        android:textSize="105sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        app:layout_constraintBottom_toTopOf="@+id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="60dp" />

    <!-- Conteúdo Rolável -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bottomNav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="36dp"
            android:paddingTop="54dp">

            <!-- Topbar (Cabeçalho) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SENAC SIGEC"
                    android:textColor="@color/primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="24dp"
                    android:text="Painel do Instrutor"
                    android:textColor="@color/secondary_container"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:src="@drawable/ic_more_vert"
                    app:tint="@color/primary" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@color/outline_variant"
                android:layout_marginBottom="18dp"/>

            <!-- Card Hero (Bom dia + Imagem do Chef) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="5dp"
                app:cardBackgroundColor="@color/primary">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Triângulo Laranja no Canto Superior Direito -->
                    <ImageView
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:layout_gravity="top|end"
                        android:src="@drawable/bg_card_corner_accent" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="8dp"
                            android:layout_height="match_parent"
                            android:background="@color/secondary_container"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:padding="18dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="QUARTA-FEIRA, 02 DE SETEMBRO"
                                android:textColor="@color/secondary_container"
                                android:textSize="14sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Bom dia, Fulano!"
                                android:textColor="#FFFFFF"
                                android:textSize="30sp"
                                android:textStyle="bold"
                                android:layout_marginTop="6dp"
                                android:layout_marginBottom="8dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Você tem 3 turmas hoje. A próxima começa às 13:30."
                                android:textColor="@color/primary_fixed_dim"
                                android:textSize="16sp"/>
                        </LinearLayout>

                        <ImageView
                            android:layout_width="96dp"
                            android:layout_height="96dp"
                            android:layout_marginEnd="14dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/img_chef_profile"/>
                    </LinearLayout>
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- Seletor de Turma / Laboratório -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_spinner_outline"
                android:orientation="horizontal"
                android:padding="16dp"
                android:layout_marginBottom="18dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TURMA / LABORATÓRIO"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Turma 2024.1.A - Padaria Lab 01"
                        android:textColor="@color/primary"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:layout_marginTop="3dp"/>
                </LinearLayout>

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="@color/primary" />
            </LinearLayout>

            <!-- CARD CENTRAL: Receitas de Hoje -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/primary">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Triângulo Laranja no Canto Superior Direito -->
                    <ImageView
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:layout_gravity="top|end"
                        android:src="@drawable/bg_card_corner_accent" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Topo do Card -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/primary"
                            android:padding="16dp"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/ic_calendar"
                                app:tint="@color/secondary_container" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="14dp"
                                android:text="Receitas de Hoje"
                                android:textColor="#FFFFFF"
                                android:textSize="22sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:src="@drawable/ic_chevron_down"
                                android:rotation="180"
                                app:tint="#FFFFFF" />
                        </LinearLayout>

                        <!-- ITEM 1: Concluído -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:background="#EAE6F8">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <LinearLayout
                                    android:layout_width="55dp"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:gravity="center">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="08:00" android:textStyle="bold" android:textColor="@color/primary" android:textSize="15sp"/>
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="12:00" android:textSize="12sp" android:textColor="@color/on_surface_variant"/>
                                </LinearLayout>

                                <View android:layout_width="1dp" android:layout_height="40dp" android:background="@color/outline_variant" android:layout_marginEnd="10dp" android:layout_marginStart="8dp"/>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Técnicas Básicas de Confeitaria" android:textStyle="bold" android:textColor="@color/primary" android:textSize="15sp" android:singleLine="true"/>
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cozinha Pedagógica 02 • Turma 2024.1.C" android:textSize="12sp" android:textColor="@color/on_surface_variant"/>
                                </LinearLayout>

                                <ImageView
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:src="@drawable/ic_check_circle"
                                    app:tint="#15803d" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="end"
                                android:text="CONCLUÍDO"
                                android:textColor="#15803d"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>

                        <View android:layout_width="match_parent" android:layout_height="2dp" android:background="@color/primary"/>

                        <!-- ITEM 2: Em Andamento -->
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="#FFFFFF">

                            <View
                                android:id="@+id/barralaranja"
                                android:layout_width="7dp"
                                android:layout_height="0dp"
                                android:background="@color/secondary_container"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toEndOf="@id/barralaranja"
                                app:layout_constraintEnd_toEndOf="parent">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:paddingTop="12dp"
                                    android:paddingBottom="8dp"
                                    android:paddingStart="10dp"
                                    android:paddingEnd="12dp"
                                    android:gravity="center_vertical">

                                    <LinearLayout
                                        android:layout_width="55dp"
                                        android:layout_height="wrap_content"
                                        android:orientation="vertical"
                                        android:gravity="center">
                                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="13:30" android:textStyle="bold" android:textColor="@color/primary" android:textSize="15sp"/>
                                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="17:30" android:textSize="12sp" android:textColor="@color/on_surface_variant"/>
                                    </LinearLayout>

                                    <View android:layout_width="1dp" android:layout_height="40dp" android:background="@color/outline_variant" android:layout_marginEnd="10dp" android:layout_marginStart="8dp"/>

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:orientation="vertical">
                                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Panificação Clássica Européia" android:textStyle="bold" android:textColor="@color/primary" android:textSize="15sp" android:singleLine="true"/>
                                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Padaria Lab 01 • Turma 2024.1.A" android:textSize="12sp" android:textColor="@color/on_surface_variant"/>
                                    </LinearLayout>

                                    <ImageView
                                        android:layout_width="30dp"
                                        android:layout_height="30dp"
                                        android:src="@drawable/ic_schedule"
                                        app:tint="@color/secondary_container" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:paddingStart="14dp"
                                    android:paddingEnd="12dp"
                                    android:paddingBottom="8dp">

                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="VER RECEITA"
                                        android:textColor="@color/secondary_container"
                                        android:textSize="11sp"
                                        android:textStyle="bold"/>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="EM ANDAMENTO"
                                        android:textColor="@color/secondary_container"
                                        android:textSize="10sp"
                                        android:textStyle="bold"/>
                                </LinearLayout>

                            </LinearLayout>
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <View android:layout_width="match_parent" android:layout_height="2dp" android:background="@color/primary"/>

                        <!-- ITEM 3: Pendente -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:background="#EAE6F8">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <LinearLayout
                                    android:layout_width="55dp"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:gravity="center">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="19:00" android:textStyle="bold" android:textColor="@color/primary" android:textSize="15sp"/>
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="22:30" android:textSize="12sp" android:textColor="@color/on_surface_variant"/>
                                </LinearLayout>

                                <View android:layout_width="1dp" android:layout_height="40dp" android:background="@color/outline_variant" android:layout_marginEnd="10dp" android:layout_marginStart="8dp"/>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cozinha Internacional: Ásia" android:textStyle="bold" android:textColor="@color/primary" android:textSize="15sp" android:singleLine="true"/>
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cozinha Pedagógica 04 • Turma 2024.2.N" android:textSize="12sp" android:textColor="@color/on_surface_variant"/>
                                </LinearLayout>

                                <ImageView
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:src="@drawable/ic_schedule"
                                    app:tint="@color/on_surface_variant" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="end"
                                android:text="PENDENTE"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>

                    </LinearLayout>
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- Botões de Checklist (Grid Inferior) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <!-- Botão 1: Insumos -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="115dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="10dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="5dp"
                    app:cardBackgroundColor="@color/primary">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="top|end"
                            android:src="@drawable/bg_card_corner_accent" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:padding="12dp"
                            android:orientation="horizontal">
                            <ImageView
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:src="@drawable/ic_list"
                                app:tint="@color/secondary_container"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:text="Checklist\ndas Aulas\n(Insumos)"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:textStyle="bold"/>
                        </LinearLayout>
                    </FrameLayout>
                </androidx.cardview.widget.CardView>

                <!-- Botão 2: Utensílios -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="115dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="5dp"
                    app:cardBackgroundColor="@color/primary">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="top|end"
                            android:src="@drawable/bg_card_corner_accent" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:padding="12dp"
                            android:orientation="horizontal">
                            <ImageView
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:src="@drawable/ic_blender"
                                app:tint="@color/secondary_container"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:text="Checklist\nde\nUtensílios"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:textStyle="bold"/>
                        </LinearLayout>
                    </FrameLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- CONTAINER DA BARRA INFERIOR (Estica até o final) -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Barra de Ícones (Tamanho FIXO de 72dp para nunca amassar os ícones) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Botão Home com a moldura -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_bottom_nav_active"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:src="@drawable/ic_home"
                        app:tint="@color/secondary_container"/>
                </LinearLayout>
            </FrameLayout>

            <ImageView
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:src="@drawable/ic_calendar"
                app:tint="@color/outline_variant"/>

            <ImageView
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:src="@drawable/ic_book"
                app:tint="@color/outline_variant"/>

            <ImageView
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:src="@drawable/ic_notifications"
                app:tint="@color/outline_variant"/>

            <ImageView
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:src="@drawable/ic_person"
                app:tint="@color/outline_variant"/>
        </LinearLayout>

        <!-- ESPAÇO FANTASMA: Vai crescer sozinho via Java -->
        <View
            android:id="@+id/systemBarSpacer"
            android:layout_width="match_parent"
            android:layout_height="0dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>