<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Camada 1: Base Laranja (cria a linha/faixa de destaque na borda inferior) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@color/secondary_container" />
        </shape>
    </item>

    <!-- Camada 2: Cartão Branco com Borda Azul-Marinho nas laterais/topo (recortado 4dp na base) -->
    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="10dp"
                android:topRightRadius="10dp"
                android:bottomLeftRadius="6dp"
                android:bottomRightRadius="6dp" />
            <solid android:color="#FFFFFF" />
            <stroke
                android:width="2.5dp"
                android:color="@color/primary" />
        </shape>
    </item>
</layer-list>