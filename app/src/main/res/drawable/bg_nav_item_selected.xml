<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Item Selecionado: exibe uma linha laranja espessa na parte inferior -->
    <item android:state_checked="true">
        <layer-list>
            <item android:bottom="0dp" android:left="0dp" android:right="0dp" android:top="76dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/senac_orange" />
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- Item normal/inativo: fundo transparente sem linha -->
    <item android:state_checked="false">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>