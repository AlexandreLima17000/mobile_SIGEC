<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.MobileSIGEC" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/sigec_white</item>
        <item name="colorPrimaryVariant">@color/sigec_white</item>
        <item name="colorOnPrimary">@color/sigec_dark_blue</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/sigec_orange</item>
        <item name="colorSecondaryVariant">@color/sigec_orange</item>
        <item name="colorOnSecondary">@color/sigec_white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/sigec_white</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.MobileSIGEC.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.MobileSIGEC.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.MobileSIGEC.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
    <style name="CalendarDayHeader">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/sigec_calendar_header</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">4dp</item>
    </style>
</resources>